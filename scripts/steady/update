#!/usr/bin/env bash

set -euo pipefail

version="${1:-}"
if [[ ! "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ || $# -ne 1 ]]; then
  echo "Usage: $0 <exact Steady version>" >&2
  exit 1
fi

cd "$(dirname "$0")"
tool_directory="$(pwd -P)"
staging_directory="$(mktemp -d "$tool_directory/.update.XXXXXXXX")"
trap 'rm -rf "$staging_directory"' EXIT

cp "$tool_directory/package.json" "$tool_directory/package-lock.json" \
  "$tool_directory/.npmrc" "$staging_directory/"
npm install --package-lock-only --ignore-scripts --save-exact --no-audit --no-fund \
  --prefix "$staging_directory" "@stdy/cli@$version"

node - "$staging_directory" "$version" <<'NODE'
const childProcess = require("child_process");
const crypto = require("crypto");
const fs = require("fs");
const path = require("path");

const root = process.argv[2];
const version = process.argv[3];
const manifestPath = path.join(root, "package.json");
const lockfilePath = path.join(root, "package-lock.json");
const manifest = JSON.parse(fs.readFileSync(manifestPath));
const lockfile = JSON.parse(fs.readFileSync(lockfilePath));
const platforms = Object.keys(manifest.steadyIntegrity.nativeBinarySha256);
const packages = ["@stdy/cli", ...platforms.map((platform) => `@stdy/cli-${platform}`)];

if (manifest.dependencies["@stdy/cli"] !== version ||
    Object.keys(lockfile.packages).length !== packages.length + 1) {
  throw new Error("Steady update unexpectedly changed its reviewed dependency graph");
}

function archiveDigest(archive, member) {
  return new Promise((resolve, reject) => {
    const hash = crypto.createHash("sha256");
    const extraction = childProcess.spawn("tar", ["-xOf", archive, member], {
      stdio: ["ignore", "pipe", "pipe"],
    });
    let errorOutput = "";
    extraction.stdout.on("data", (chunk) => hash.update(chunk));
    extraction.stderr.on("data", (chunk) => { errorOutput += chunk; });
    extraction.on("error", reject);
    extraction.on("close", (status) => {
      if (status === 0) resolve(hash.digest("hex"));
      else reject(new Error(errorOutput || `Could not extract ${member}`));
    });
  });
}

async function refresh() {
  for (const name of packages) {
    const entry = lockfile.packages[`node_modules/${name}`];
    if (!entry || entry.version !== version || entry.license !== "MIT") {
      throw new Error(`${name} does not match the approved MIT-licensed release`);
    }

    const packed = childProcess.spawnSync("npm", [
      "pack", "--ignore-scripts", "--silent", "--pack-destination", root, `${name}@${version}`,
    ], { encoding: "utf8" });
    if (packed.status !== 0) throw new Error(packed.stderr || `Could not download ${name}`);

    const archive = path.join(root, packed.stdout.trim().split("\n").pop());
    const integrity = `sha512-${crypto.createHash("sha512")
      .update(fs.readFileSync(archive)).digest("base64")}`;
    if (integrity !== entry.integrity) {
      throw new Error(`${name} archive does not match its locked SHA-512 integrity`);
    }

    const platform = name.replace("@stdy/cli-", "");
    const member = name === "@stdy/cli"
      ? "package/steady.js"
      : `package/bin/${platform.startsWith("win32-") ? "steady.exe" : "steady"}`;
    const digest = await archiveDigest(archive, member);
    if (name === "@stdy/cli") manifest.steadyIntegrity.wrapperSha256 = digest;
    else manifest.steadyIntegrity.nativeBinarySha256[platform] = digest;

    const filename = path.basename(new URL(entry.resolved).pathname);
    entry.resolved = `https://registry.npmjs.org/${name}/-/${filename}`;
  }

  fs.writeFileSync(manifestPath, `${JSON.stringify(manifest, null, 2)}\n`);
  fs.writeFileSync(lockfilePath, `${JSON.stringify(lockfile, null, 2)}\n`);
}

refresh().catch((error) => {
  console.error(error.message);
  process.exitCode = 1;
});
NODE

cp "$staging_directory/package.json" "$tool_directory/package.json"
cp "$staging_directory/package-lock.json" "$tool_directory/package-lock.json"

# The next bootstrap must install artifacts for the newly reviewed version.
rm -rf "$tool_directory/node_modules"
