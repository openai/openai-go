#!/usr/bin/env bash

set -e

cd "$(dirname "$0")/.."

# Castiron runs this hook in a formatter workspace without Git metadata.
# Contributors should normally use the standard go fmt commands documented in
# CONTRIBUTING.md.
echo "==> Running gofmt -w"
find . -type d \( -name .git -o -name vendor -o -name .codex-automation \) -prune \
  -o -type f -name '*.go' -exec gofmt -w {} +
