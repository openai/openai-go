#!/usr/bin/env bash

set -e

cd "$(dirname "$0")/.."

echo "==> Detecting breaking changes"

TEST_PATHS=(
	client_test.go
	completion_test.go
	chatcompletion_test.go
	chatcompletionmessage_test.go
	embedding_test.go
	file_test.go
	image_test.go
	contentprovenancecheck_test.go
	audiotranscription_test.go
	audiotranslation_test.go
	audiospeech_test.go
	moderation_test.go
	model_test.go
	finetuningjob_test.go
	finetuningjobcheckpoint_test.go
	finetuningcheckpointpermission_test.go
	finetuningalphagrader_test.go
	vectorstore_test.go
	vectorstorefile_test.go
	vectorstorefilebatch_test.go
	webhooks/webhook_test.go
	betaresponse_test.go
	betaresponseinputitem_test.go
	betaresponseinputtoken_test.go
	betachatkitsession_test.go
	betachatkitthread_test.go
	betaassistant_test.go
	betathread_test.go
	betathreadrun_test.go
	betathreadrunstep_test.go
	betathreadmessage_test.go
	batch_test.go
	upload_test.go
	uploadpart_test.go
	adminorganizationauditlog_test.go
	adminorganizationadminapikey_test.go
	adminorganizationusage_test.go
	adminorganizationinvite_test.go
	adminorganizationuser_test.go
	adminorganizationuserrole_test.go
	adminorganizationgroup_test.go
	adminorganizationgroupuser_test.go
	adminorganizationgrouprole_test.go
	adminorganizationrole_test.go
	adminorganizationdataretention_test.go
	adminorganizationspendlimit_test.go
	adminorganizationspendalert_test.go
	adminorganizationcertificate_test.go
	adminorganizationproject_test.go
	adminorganizationprojectuser_test.go
	adminorganizationprojectuserrole_test.go
	adminorganizationprojectserviceaccount_test.go
	adminorganizationprojectserviceaccountapikey_test.go
	adminorganizationprojectapikey_test.go
	adminorganizationprojectratelimit_test.go
	adminorganizationprojectmodelpermission_test.go
	adminorganizationprojecthostedtoolpermission_test.go
	adminorganizationprojectgroup_test.go
	adminorganizationprojectgrouprole_test.go
	adminorganizationprojectrole_test.go
	adminorganizationprojectdataretention_test.go
	adminorganizationprojectspendlimit_test.go
	adminorganizationprojectspendalert_test.go
	adminorganizationprojectcertificate_test.go
	responses/response_test.go
	responses/inputitem_test.go
	responses/inputtoken_test.go
	realtime/clientsecret_test.go
	realtime/call_test.go
	conversations/conversation_test.go
	conversations/item_test.go
	container_test.go
	containerfile_test.go
	containerfilecontent_test.go
	skill_test.go
	skillcontent_test.go
	skillversion_test.go
	skillversioncontent_test.go
	video_test.go
	usage_test.go
	paginationauto_test.go
	paginationmanual_test.go
)

# Restore only paths present at the baseline so missing files remain untouched.
historical_paths=$(mktemp)
trap 'rm -f "$historical_paths"' EXIT
git ls-tree -r -z --name-only "$1" -- "${TEST_PATHS[@]}" > "$historical_paths"
if [[ -s "$historical_paths" ]]; then
    git --literal-pathspecs checkout "$1" --pathspec-from-file="$historical_paths" --pathspec-file-nul
fi

# Compile historical tests against the current SDK without running them.
go test -c -vet=off -o /dev/null ./...
