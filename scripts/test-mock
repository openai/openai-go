#!/usr/bin/env bash

set -euo pipefail

cd "$(dirname "$0")/.."

temporary="$(mktemp -d)"
marker="$temporary/executed"
wrapper="scripts/steady/node_modules/@stdy/cli/steady.js"

cleanup() {
  rm -rf "$temporary"
  npm ci --prefix scripts/steady --offline --ignore-scripts --include=optional --no-audit --no-fund >/dev/null
}
trap cleanup EXIT

printf 'require("fs").writeFileSync(process.env.STEADY_TEST_MARKER, "executed")\n' >"$wrapper"

if STEADY_TEST_MARKER="$marker" npm_config_offline=true ./scripts/mock /nonexistent-openapi-spec.yml >/dev/null 2>&1; then
  status=0
else
  status=$?
fi

if [[ -e "$marker" ]]; then
  echo "Mock server executed an unverified existing Steady installation" >&2
  exit 1
fi

if [[ "$status" -eq 0 ]]; then
  echo "Mock server accepted an invalid OpenAPI specification" >&2
  exit 1
fi

expected_version="$(node -p 'require("./scripts/steady/package.json").dependencies["@stdy/cli"]')"
node "$wrapper" --version | grep -Fx "steady $expected_version" >/dev/null
echo "Mock server rejected tampered existing Steady bytes"

native="$(node -e '
  const path = require("path");
  const name = `@stdy/cli-${process.platform}-${process.arch}`;
  const manifest = require.resolve(`${name}/package.json`, {
    paths: [path.resolve("scripts/steady/node_modules/@stdy/cli")],
  });
  process.stdout.write(path.join(path.dirname(manifest), "bin", process.platform === "win32" ? "steady.exe" : "steady"));
')"
printf '#!/bin/sh\nprintf "executed" >"$STEADY_TEST_MARKER"\n' >"$native"
chmod +x "$native"

if STEADY_TEST_MARKER="$marker" npm_config_offline=true ./scripts/mock /nonexistent-openapi-spec.yml >/dev/null 2>&1; then
  status=0
else
  status=$?
fi
if [[ -e "$marker" || "$status" -eq 0 ]]; then
  echo "Mock server executed an unverified existing Steady native executable" >&2
  exit 1
fi
"$native" --version | grep -Fx "steady $expected_version" >/dev/null
echo "Mock server rejected and replaced tampered existing native executable bytes"

printf '#!/bin/sh\nprintf "%%s" "$STEADY_TEST_SECRET" >"$STEADY_TEST_MARKER"\n' >"$native"
chmod +x "$native"
if ! STEADY_TEST_MARKER="$marker" STEADY_TEST_SECRET=synthetic-dry-run-credential \
  npm_config_offline=true npm_config_dry_run=true ./scripts/steady/install >"$temporary/output" 2>&1; then
  echo "Steady installation did not override inherited npm dry-run mode" >&2
  exit 1
fi
if [[ -e "$marker" ]]; then
  echo "Inherited npm dry-run executed a forged existing native with developer credentials" >&2
  exit 1
fi
"$native" --version | grep -Fx "steady $expected_version" >/dev/null
echo "Inherited npm dry-run cannot skip authenticated native installation"

printf 'dry-run=true\npackage-lock-only=true\nglobal=true\npackage-lock=false\nomit=optional\nignore-scripts=false\n' \
  >"$temporary/hostile.npmrc"
printf '#!/bin/sh\nprintf "%%s" "$STEADY_TEST_SECRET" >"$STEADY_TEST_MARKER"\n' >"$native"
chmod +x "$native"
if ! STEADY_TEST_MARKER="$marker" STEADY_TEST_SECRET=synthetic-userconfig-credential \
  npm_config_offline=true npm_config_global=true npm_config_package_lock=false \
  npm_config_prefix="$temporary/untrusted-prefix" npm_config_userconfig="$temporary/hostile.npmrc" \
  ./scripts/steady/install >"$temporary/output" 2>&1; then
  echo "Steady installation did not override hostile inherited npm configuration" >&2
  exit 1
fi
if [[ -e "$marker" ]]; then
  echo "Hostile npm user configuration executed a forged existing native" >&2
  exit 1
fi
if [[ -e "$temporary/untrusted-prefix" ]]; then
  echo "Hostile npm configuration redirected the authenticated installation prefix" >&2
  exit 1
fi
"$native" --version | grep -Fx "steady $expected_version" >/dev/null
echo "Hostile npm user configuration cannot disable authenticated installation"

platform="$(node -p 'process.platform + "-" + process.arch')"
native_name="$(node -p 'process.platform === "win32" ? "steady.exe" : "steady"')"
forged_package="$temporary/forged-native/package"
mkdir -p "$forged_package/bin"
printf '{"name":"@stdy/cli-%s","version":"%s"}\n' "$platform" "$expected_version" >"$forged_package/package.json"
printf '#!/bin/sh\nprintf "%%s" "$STEADY_TEST_SECRET" >"$STEADY_TEST_MARKER"\nprintf "steady %s\\n"\n' \
  "$expected_version" >"$forged_package/bin/$native_name"
chmod +x "$forged_package/bin/$native_name"
tar -czf "$temporary/forged-native.tgz" -C "$temporary/forged-native" package

malicious_shrinkwrap="$temporary/malicious-shrinkwrap.json"
node -e '
  const fs = require("fs");
  const crypto = require("crypto");
  const lock = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
  const archive = process.argv[2];
  const native = lock.packages[`node_modules/@stdy/cli-${process.platform}-${process.arch}`];
  native.resolved = `file:${archive}`;
  native.integrity = `sha512-${crypto.createHash("sha512").update(fs.readFileSync(archive)).digest("base64")}`;
  fs.writeFileSync(process.argv[3], JSON.stringify(lock, null, 2));
' scripts/steady/package-lock.json "$temporary/forged-native.tgz" "$malicious_shrinkwrap"

for shrinkwrap_kind in regular symlink dangling-symlink; do
  shrinkwrap_fixture="$temporary/shrinkwrap-$shrinkwrap_kind"
  mkdir -p "$shrinkwrap_fixture/scripts/steady"
  cp scripts/steady/install scripts/steady/package.json scripts/steady/package-lock.json "$shrinkwrap_fixture/scripts/steady/"
  if [[ "$shrinkwrap_kind" == regular ]]; then
    cp "$malicious_shrinkwrap" "$shrinkwrap_fixture/scripts/steady/npm-shrinkwrap.json"
  elif [[ "$shrinkwrap_kind" == symlink ]]; then
    ln -s "$malicious_shrinkwrap" "$shrinkwrap_fixture/scripts/steady/npm-shrinkwrap.json"
  else
    ln -s "$temporary/nonexistent-shrinkwrap.json" "$shrinkwrap_fixture/scripts/steady/npm-shrinkwrap.json"
  fi
  printf 'dry-run=true\npackage-lock-only=true\nglobal=true\n' >"$shrinkwrap_fixture/scripts/steady/.npmrc"

  if ! STEADY_TEST_MARKER="$marker" STEADY_TEST_SECRET="synthetic-$shrinkwrap_kind-credential" \
    npm_config_offline=true "$shrinkwrap_fixture/scripts/steady/install" >"$temporary/output" 2>&1; then
    echo "Steady installation failed with an untrusted $shrinkwrap_kind shrinkwrap present" >&2
    exit 1
  fi
  if [[ -e "$marker" ]]; then
    echo "A $shrinkwrap_kind shrinkwrap replaced the committed lockfile and exposed developer credentials" >&2
    exit 1
  fi
  node "$shrinkwrap_fixture/scripts/steady/node_modules/@stdy/cli/steady.js" --version |
    grep -Fx "steady $expected_version" >/dev/null
done
echo "Regular, symlinked, and dangling npm shrinkwrap files cannot override the committed lockfile"

npm_stub="$temporary/npm"
go_stub="$temporary/go"
printf '#!/bin/sh\nif [ "$1" = "--version" ]; then echo 6.14.18; else touch "$STEADY_TEST_MARKER"; fi\n' >"$npm_stub"
printf '#!/bin/sh\ntouch "$STEADY_TEST_MARKER"\n' >"$go_stub"
chmod +x "$npm_stub" "$go_stub"

for script in bootstrap mock; do
  if PATH="$temporary:$PATH" STEADY_TEST_MARKER="$marker" SKIP_BREW=1 \
    "./scripts/$script" /nonexistent-openapi-spec.yml >"$temporary/output" 2>&1; then
    echo "$script accepted npm 6 for a version 3 lockfile" >&2
    exit 1
  fi

  grep -F 'npm 7 or later is required' "$temporary/output" >/dev/null
  if [[ -e "$marker" ]]; then
    echo "$script invoked npm before rejecting its unsupported version" >&2
    exit 1
  fi
done
echo "Bootstrap and mock rejected unsupported npm 6 before installation"

real_node="$(command -v node)"
node_stub="$temporary/node"
cat >"$node_stub" <<'EOF'
#!/bin/sh
if [ "$1" = "--version" ]; then
  echo v14.0.0
elif [ "$1" = "-e" ] && printf '%s' "$2" | grep -q 'node:'; then
  echo "Error: Cannot find node:-prefixed built-in modules on Node.js 14.0" >&2
  exit 1
else
  exec "$STEADY_REAL_NODE" "$@"
fi
EOF
chmod +x "$node_stub"

if PATH="$temporary:$PATH" STEADY_REAL_NODE="$real_node" STEADY_TEST_MARKER="$marker" \
  ./scripts/mock --daemon >"$temporary/output" 2>&1; then
  echo "Mock server accepted npm 6 while checking the Node.js 14 minimum" >&2
  exit 1
fi
grep -F 'npm 7 or later is required' "$temporary/output" >/dev/null
echo "Default mock specification verification supports Node.js 14.0"

rm -f "$npm_stub" "$go_stub"
printf '#!/bin/sh\nif [ "$1" = "--version" ]; then echo v13.14.0; else exec "$STEADY_REAL_NODE" "$@"; fi\n' >"$node_stub"
printf '#!/bin/sh\ntouch "$STEADY_TEST_MARKER"\n' >"$go_stub"
chmod +x "$node_stub" "$go_stub"

for script in bootstrap mock; do
  if PATH="$temporary:$PATH" STEADY_REAL_NODE="$real_node" STEADY_TEST_MARKER="$marker" SKIP_BREW=1 \
    npm_config_offline=true "./scripts/$script" /nonexistent-openapi-spec.yml >"$temporary/output" 2>&1; then
    echo "$script accepted Node.js 13 below Steady's supported minimum" >&2
    exit 1
  fi

  grep -F 'Node.js 14 or later is required' "$temporary/output" >/dev/null
  if [[ -e "$marker" ]]; then
    echo "$script modified Go dependencies before rejecting unsupported Node.js" >&2
    exit 1
  fi
done
echo "Bootstrap and mock rejected unsupported Node.js 13 before installation"

rm -f "$node_stub" "$go_stub"
printf '#!/bin/sh\nexit 0\n' >"$go_stub"
chmod +x "$go_stub"

fixture="$temporary/project"
ancestor_package="$temporary/node_modules/@stdy/cli-$platform"
mkdir -p "$fixture/scripts/steady" "$ancestor_package/bin"
cp scripts/bootstrap "$fixture/scripts/bootstrap"
cp scripts/steady/install scripts/steady/package.json scripts/steady/package-lock.json "$fixture/scripts/steady/"
printf '{"name":"@stdy/cli-%s","version":"%s"}\n' "$platform" "$expected_version" >"$ancestor_package/package.json"
printf '#!/bin/sh\nprintf "%%s" "$STEADY_TEST_SECRET" >"$STEADY_TEST_MARKER"\n' >"$ancestor_package/bin/$native_name"
chmod +x "$fixture/scripts/bootstrap" "$fixture/scripts/steady/install" "$ancestor_package/bin/$native_name"

if PATH="$temporary:$PATH" STEADY_TEST_MARKER="$marker" STEADY_TEST_SECRET=synthetic-credential \
  SKIP_BREW=1 npm_config_offline=true npm_config_cpu=ia32 \
  "$fixture/scripts/bootstrap" >"$temporary/output" 2>&1; then
  echo "Bootstrap accepted an installation without Steady's active platform-native package" >&2
  exit 1
fi
grep -F 'Missing locked Steady platform-native executable' "$temporary/output" >/dev/null
if [[ -e "$marker" ]]; then
  echo "Bootstrap executed an unpinned ancestor-native package and exposed a credential" >&2
  exit 1
fi
echo "Bootstrap rejected a real npm installation missing its native package without executing an ancestor binary"

linked_fixture="$temporary/linked-project"
mkdir -p "$linked_fixture/scripts/steady"
cp scripts/steady/install scripts/steady/package.json scripts/steady/package-lock.json "$linked_fixture/scripts/steady/"
chmod +x "$linked_fixture/scripts/steady/install"
npm_config_offline=true npm_config_install_strategy=linked "$linked_fixture/scripts/steady/install" >"$temporary/output" 2>&1
node "$linked_fixture/scripts/steady/node_modules/@stdy/cli/steady.js" --version | grep -Fx "steady $expected_version" >/dev/null
echo "Locked Steady installation supports npm's linked package layout"

linked_wrapper="$(node -e '
  process.stdout.write(require("fs").realpathSync(process.argv[1]));
' "$linked_fixture/scripts/steady/node_modules/@stdy/cli/steady.js")"
native_package="$(node -e '
  const path = require("path");
  const name = `@stdy/cli-${process.platform}-${process.arch}`;
  const manifest = require.resolve(`${name}/package.json`, { paths: [path.dirname(process.argv[1])] });
  process.stdout.write(path.dirname(manifest));
' "$linked_wrapper")"
linked_sibling="$(dirname "$linked_wrapper")/../cli-$platform"
mv "$linked_sibling" "$temporary/original-linked-sibling"
mkdir -p "$linked_sibling/bin"
printf '#!/bin/sh\nprintf "executed" >"$STEADY_TEST_MARKER"\n' >"$linked_sibling/bin/$native_name"
chmod +x "$linked_sibling/bin/$native_name"
ln -s "$native_package" "$linked_fixture/scripts/steady/node_modules/@stdy/cli-$platform"

verified_native="$(STEADY_TEST_MARKER="$marker" npm_config_offline=true \
  "$linked_fixture/scripts/steady/install" --print-executable)"
STEADY_TEST_MARKER="$marker" "$verified_native" --version | grep -Fx "steady $expected_version" >/dev/null
if [[ -e "$marker" ]]; then
  echo "Steady executed an unverified shadow native instead of the locked package" >&2
  exit 1
fi
echo "Steady executes the authenticated native instead of a shadowing wrapper candidate"

mv "$verified_native" "$temporary/authenticated-native"
ln -s "$forged_package/bin/$native_name" "$verified_native"
if ! STEADY_TEST_MARKER="$marker" STEADY_TEST_SECRET=synthetic-symlink-credential \
  npm_config_offline=true "$linked_fixture/scripts/steady/install" --print-executable \
  >"$temporary/output" 2>&1; then
  echo "Steady failed to replace a native executable symlink outside its locked package" >&2
  exit 1
fi
if [[ -e "$marker" ]]; then
  echo "Steady executed an escaping native executable symlink" >&2
  exit 1
fi
echo "Steady rejects native executable symlinks that escape the locked package"

concurrent_fixture="$temporary/concurrent-project"
mkdir -p "$concurrent_fixture/scripts/steady"
cp scripts/steady/install scripts/steady/package.json scripts/steady/package-lock.json "$concurrent_fixture/scripts/steady/"
chmod +x "$concurrent_fixture/scripts/steady/install"
mkdir "$concurrent_fixture/scripts/steady/.publication-lock"
touch "$concurrent_fixture/scripts/steady/.publication-lock/owner.2147483647.abandoned"

concurrent_bin="$temporary/concurrent-bin"
concurrent_barrier="$temporary/concurrent-barrier"
mkdir -p "$concurrent_bin" "$concurrent_barrier"
real_npm="$(command -v npm)"
cat >"$concurrent_bin/npm" <<'EOF'
#!/usr/bin/env bash
set -e

if [[ "$1" == "--version" ]]; then
  exec "$STEADY_REAL_NPM" "$@"
fi

"$STEADY_REAL_NPM" "$@"
touch "$STEADY_CONCURRENCY_BARRIER/arrived.$$"
for attempt in {1..300}; do
  arrivals=("$STEADY_CONCURRENCY_BARRIER"/arrived.*)
  if [[ "${#arrivals[@]}" -ge "$STEADY_CONCURRENCY_WORKERS" ]]; then
    exit 0
  fi
  sleep 0.05
done
echo "Concurrent Steady installation did not reach its publication barrier" >&2
exit 1
EOF
chmod +x "$concurrent_bin/npm"
cat >"$concurrent_bin/node" <<'EOF'
#!/usr/bin/env bash
set -e

if [[ "${1:-}" == "-e" && "${2:-}" == *renameSync* && "${4:-}" == */node_modules ]]; then
  touch "$STEADY_CONCURRENCY_BARRIER/publishing.$$"
  for attempt in {1..60}; do
    publishers=("$STEADY_CONCURRENCY_BARRIER"/publishing.*)
    if [[ "${#publishers[@]}" -ge "$STEADY_CONCURRENCY_WORKERS" ]]; then
      break
    fi
    sleep 0.025
  done
fi

exec "$STEADY_REAL_NODE" "$@"
EOF
chmod +x "$concurrent_bin/node"

processes=()
for index in 1 2 3 4 5 6; do
  PATH="$concurrent_bin:$PATH" STEADY_REAL_NPM="$real_npm" STEADY_REAL_NODE="$real_node" \
    STEADY_CONCURRENCY_BARRIER="$concurrent_barrier" STEADY_CONCURRENCY_WORKERS=6 \
    npm_config_offline=true "$concurrent_fixture/scripts/steady/install" >"$temporary/concurrent-$index" 2>&1 &
  processes+=("$!")
done

failures=0
for index in "${!processes[@]}"; do
  if ! wait "${processes[$index]}"; then
    cat "$temporary/concurrent-$((index + 1))" >&2
    failures=$((failures + 1))
  fi
done
if [[ "$failures" -ne 0 ]]; then
  echo "$failures concurrent Steady installations failed during publication" >&2
  exit 1
fi

node "$concurrent_fixture/scripts/steady/node_modules/@stdy/cli/steady.js" --version | grep -Fx "steady $expected_version" >/dev/null
if [[ -e "$concurrent_fixture/scripts/steady/.publication-lock" ]]; then
  echo "Concurrent Steady installations left an unreleased publication lock" >&2
  exit 1
fi
echo "Concurrent Steady installations recover abandoned locks and publish without interfering"

mkdir "$concurrent_fixture/scripts/steady/.publication-lock"
npm_config_offline=true "$concurrent_fixture/scripts/steady/install" >"$temporary/output" 2>&1
if [[ -e "$concurrent_fixture/scripts/steady/.publication-lock" ]]; then
  echo "Steady installation left an ownerless publication lock behind" >&2
  exit 1
fi
echo "Steady installation safely recovers an ownerless publication lock"
