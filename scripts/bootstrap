#!/usr/bin/env bash

set -e

cd "$(dirname "$0")/.."

if [ -f "Brewfile" ] && [ "$(uname -s)" = "Darwin" ] && [ "${SKIP_BREW:-}" != "1" ] && [ -t 0 ]; then
  brew bundle check >/dev/null 2>&1 || {
    echo -n "==> Install Homebrew dependencies? (y/N): "
    read -r response
    case "$response" in
      [yY][eE][sS]|[yY])
        brew bundle
        ;;
      *)
        ;;
    esac
    echo
  }
fi

if ! command -v node >/dev/null || ! command -v npm >/dev/null; then
  echo "Error: Node.js and npm are required; install them manually or with brew bundle" >&2
  exit 1
fi

npm_version="$(npm --version)"
if [[ "${npm_version%%.*}" -lt 7 ]]; then
  echo "Error: npm 7 or later is required for the locked Steady mock server (found $npm_version)" >&2
  exit 1
fi

echo "==> Installing Go dependencies…"

go mod tidy -e

echo "==> Installing the locked Steady mock server…"
npm ci --prefix scripts/steady --ignore-scripts --include=optional --no-audit --no-fund
