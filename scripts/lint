#!/bin/sh

set -eu

cd "$(dirname "$0")/.."
repo_root="$PWD"
lint_tests="${OPENAI_GO_LINT_TESTS:-true}"
lint_runner="$(go tool -modfile="$repo_root/tools/go.mod" -n golangci-lint)"

"$lint_runner" fmt --config="$repo_root/.golangci.yml" --diff ./tools/...

if [ "$lint_tests" = false ]; then
  go test -run='^$' ./...
  set -- --disable=unused
else
  set --
fi

scope="${OPENAI_GO_LINT_SCOPE:-all}"
case "$scope" in
  all) modules=". examples internal/testdata/consumer" ;;
  root) modules="."; set -- "$@" . ;;
  packages)
    modules="."
    root_package="$(go list -f '{{.ImportPath}}' .)"
    packages="$(go list ./...)"
    found=false
    # Discover new packages automatically instead of maintaining an allowlist.
    for package in $packages; do
      if [ "$package" != "$root_package" ]; then
        set -- "$@" "./${package#"$root_package"/}"
        found=true
      fi
    done
    if [ "$found" = false ]; then exit 0; fi
    ;;
  examples) modules="examples internal/testdata/consumer" ;;
  windows) modules="" ;;
  *) echo "Unknown lint scope: $scope" >&2; exit 2 ;;
esac

for module in $modules; do
  (
    cd "$module"
    "$lint_runner" run --config="$repo_root/.golangci.yml" --tests="$lint_tests" "$@"
  )
done

# This example is excluded on Linux because its audio dependency needs native
# system libraries there. Analyze it on a supported target without repeating
# the full SDK analysis: the SDK and consumer select the same source on both.
if { [ "$scope" = all ] || [ "$scope" = windows ]; } && [ "$lint_tests" = true ] && [ "$(go env GOOS)" = linux ]; then
  (
    cd examples
    GOOS=windows GOARCH=arm64 CGO_ENABLED=0 \
      "$lint_runner" run --config="$repo_root/.golangci.yml" --tests=true \
      ./audio-text-to-speech
  )
fi
