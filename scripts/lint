#!/usr/bin/env bash

set -e

cd "$(dirname "$0")/.."

echo "==> Checking Go formatting"
unformatted="$(find . -type d \( -name .git -o -name vendor -o -name .codex-automation \) -prune \
  -o -type f -name '*.go' -exec gofmt -l {} +)"
if [[ -n "$unformatted" ]]; then
  echo "The following files are not formatted with gofmt:"
  printf '%s\n' "$unformatted"
  echo
  find . -type d \( -name .git -o -name vendor -o -name .codex-automation \) -prune \
    -o -type f -name '*.go' -exec gofmt -d {} +
  echo "Run ./scripts/format to fix formatting."
  exit 1
fi

echo "==> Running Go build"
go build ./...

echo "==> Checking tests compile"
go test -run=^$ ./...

echo "==> Building examples"
cd examples && go build ./...
